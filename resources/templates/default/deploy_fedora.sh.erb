#!/bin/bash
#
# deploy_fedora.sh - Instala (o actualiza) el cliente GRR en Fedora/RHEL/Rocky,
# fija su etiqueta y registra el servidor GRR en /etc/hosts.
#
# El instalador (.rpm) es el mismo para todas las sedes y se busca junto a este
# script. La etiqueta se lee en cada arranque del cliente desde /etc/grr_labels
# y el servidor la usa para decidir a que sensor pertenece el endpoint: debe
# coincidir con el nombre del sensor (sin importar mayusculas); si no coincide
# con ninguno, el endpoint va al sensor por defecto.
#
# Uso interactivo (pregunta lo que falte):
#   sudo ./deploy_fedora.sh
#   - Etiqueta: si se pulsa Enter queda vacia (el equipo va al sensor por defecto).
#   - IP y nombre del servidor GRR: se muestran entre corchetes los valores con
#     los que se ha generado este script; Enter los acepta y, si se escribe otro
#     valor, lo sustituye.
#
# Uso por parametros:
#   sudo ./deploy_fedora.sh -l <sensor> [-i <IP> -n <nombre.dominio>] [-y]
#   Sin -i / -n se usan los valores con los que se ha generado este script.
#
# Opciones:
#   -l, --label NOMBRE      Etiqueta: nombre del sensor del endpoint. Con ""
#                           se deja el equipo sin etiqueta.
#   -i, --server-ip IP      IP (v4 o v6) del servidor GRR.
#   -n, --server-name FQDN  Nombre del servidor GRR con su dominio. Se pueden
#                           indicar varios separados por comas o espacios.
#   -r, --rpm FICHERO       Instalador. Por defecto, el .rpm junto a este script.
#       --no-hosts          No modificar /etc/hosts.
#   -y, --yes               No pedir confirmacion.
#       --force             Reinicia el cliente aunque no haya cambios.
#   -h, --help              Esta ayuda.
#
set -euo pipefail

# Sobrescribibles por entorno (solo para pruebas).
LABEL_FILE="${GRR_LABEL_FILE:-/etc/grr_labels}"
HOSTS_FILE="${GRR_HOSTS_FILE:-/etc/hosts}"
SERVICE="${GRR_SERVICE:-fleetspeak-client}"
WAIT_SECONDS="${GRR_WAIT_SECONDS:-30}"
SERVER_PORT="${GRR_SERVER_PORT:-8443}"

# Servidor GRR con el que se ha generado este script (los rellena el servidor).
DEFAULT_SERVER_IP='<%= @server_ip %>'
DEFAULT_SERVER_NAME='<%= @server_name %>'

HOSTS_BEGIN="# BEGIN GRR-CLIENT (gestionado por deploy_fedora.sh, no editar)"
HOSTS_END="# END GRR-CLIENT"

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

LABEL=""
LABEL_GIVEN=0
SERVER_IP=""
SERVER_NAMES_RAW=""
RPM=""
FORCE=0
ASSUME_YES=0
SKIP_HOSTS=0
SERVER_NAMES=()

INTERACTIVE=0
[[ -t 0 ]] && INTERACTIVE=1

TMP_FILES=()
cleanup() {
  local f
  for f in "${TMP_FILES[@]:-}"; do
    [[ -n "$f" ]] && rm -f "$f"
  done
  return 0
}
trap cleanup EXIT

usage() {
  sed -n '2,/^set -euo/p' "$0" | sed '$d' | sed 's/^# \{0,1\}//' >&2
  exit "${1:-1}"
}

die()  { echo "Error: $*" >&2; exit 1; }
warn() { echo "Aviso: $*" >&2; }

trim() {
  local s="$1"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}

# ask VARIABLE "Pregunta" [valor-por-defecto]
ask() {
  local __var="$1" prompt="$2" def="${3:-}" ans=""
  if [[ -n "$def" ]]; then
    read -r -p "$prompt [$def]: " ans || true
    ans="${ans:-$def}"
  else
    read -r -p "$prompt: " ans || true
  fi
  printf -v "$__var" '%s' "$(trim "$ans")"
}

# ---------------------------------------------------------------- validacion

valid_ipv4() {
  local o
  [[ "$1" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})$ ]] || return 1
  for o in "${BASH_REMATCH[@]:1}"; do
    (( 10#$o <= 255 )) || return 1
  done
}

valid_ipv6() {
  [[ "$1" == *:* && "$1" != *:::* && "$1" =~ ^[0-9A-Fa-f:]+(\.[0-9]{1,3}){0,3}$ ]]
}

valid_ip() { valid_ipv4 "$1" || valid_ipv6 "$1"; }

valid_hostname() {
  local h="$1"
  (( ${#h} <= 253 )) || return 1
  [[ "$h" =~ ^[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$ ]]
}

validate_label() {
  # La etiqueta puede estar vacia (equipo sin etiqueta). El fichero es una lista
  # separada por comas: no puede contenerlas ni llevar saltos de linea u otros
  # caracteres de control.
  [[ -n "$LABEL" ]] || return 0
  [[ "$LABEL" != *,* ]] || die "etiqueta no valida: no puede contener comas."
  [[ ! "$LABEL" =~ [[:cntrl:]] ]] || die "etiqueta no valida: no puede contener saltos de linea ni caracteres de control."
  (( ${#LABEL} <= 128 )) || die "etiqueta demasiado larga (maximo 128 caracteres)."
}

validate_server() {
  local n
  [[ -n "$SERVER_IP" ]] || die "falta la IP del servidor GRR (-i)."
  valid_ip "$SERVER_IP" || die "IP no valida: '$SERVER_IP'."

  read -r -a SERVER_NAMES <<< "${SERVER_NAMES_RAW//,/ }"
  (( ${#SERVER_NAMES[@]} > 0 )) || die "falta el nombre del servidor GRR (-n)."
  for n in "${SERVER_NAMES[@]}"; do
    valid_hostname "$n" || die "nombre de host no valido: '$n'."
    [[ "$n" == *.* ]] || warn "'$n' no lleva dominio; se esperaba un nombre del tipo host.dominio."
  done
}

# ---------------------------------------------------------------- argumentos

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--label)       [[ $# -ge 2 ]] || usage; LABEL="$2"; LABEL_GIVEN=1; shift 2 ;;
    -i|--server-ip)   [[ $# -ge 2 ]] || usage; SERVER_IP="$2";        shift 2 ;;
    -n|--server-name) [[ $# -ge 2 ]] || usage; SERVER_NAMES_RAW="$2"; shift 2 ;;
    -r|--rpm)         [[ $# -ge 2 ]] || usage; RPM="$2";              shift 2 ;;
    --no-hosts)       SKIP_HOSTS=1; shift ;;
    -y|--yes)         ASSUME_YES=1; shift ;;
    --force)          FORCE=1; shift ;;
    -h|--help)        usage 0 ;;
    *) echo "Opcion desconocida: $1" >&2; usage ;;
  esac
done

LABEL="$(trim "$LABEL")"
SERVER_IP="$(trim "$SERVER_IP")"
SERVER_NAMES_RAW="$(trim "$SERVER_NAMES_RAW")"

[[ $EUID -eq 0 ]] || die "ejecuta este script como root (sudo)."

# ------------------------------------------------- valores actuales (defecto)

current_label() {
  [[ -f "$LABEL_FILE" ]] && head -n1 "$LABEL_FILE" | tr -d '\r' || true
}

# Primera linea del bloque gestionado de /etc/hosts: "IP nombre [nombre...]"
current_hosts_entry() {
  [[ -f "$HOSTS_FILE" ]] || return 0
  awk -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '
    $0 == b { blk = 1; next }
    $0 == e { blk = 0 }
    blk && $1 !~ /^#/ && NF >= 2 { print; exit }
  ' "$HOSTS_FILE"
}

# Valores por defecto del servidor: los de la plantilla y, si no los hay, lo que
# ya tenga este equipo en /etc/hosts. Rellena DEF_IP y DEF_NAMES.
compute_server_defaults() {
  local entry
  DEF_IP="$(trim "$DEFAULT_SERVER_IP")"
  DEF_NAMES="$(trim "$DEFAULT_SERVER_NAME")"
  if [[ -z "$DEF_IP" || -z "$DEF_NAMES" ]]; then
    entry="$(current_hosts_entry)"
    [[ -z "$DEF_IP" ]] && DEF_IP="${entry%% *}"
    if [[ -z "$DEF_NAMES" && "$entry" == *" "* ]]; then
      DEF_NAMES="${entry#* }"
    fi
  fi
  return 0
}

# --------------------------------------------------------- instalador (.rpm)

find_rpms() {
  local dir
  for dir in "$SCRIPT_DIR" "$PWD"; do
    mapfile -t FOUND_RPMS < <(find "$dir" -maxdepth 1 -type f -name '*.rpm' 2>/dev/null | sort)
    (( ${#FOUND_RPMS[@]} > 0 )) && return 0
    [[ "$PWD" == "$SCRIPT_DIR" ]] && break
  done
  FOUND_RPMS=()
}

choose_rpm() {
  local i choice
  find_rpms
  case ${#FOUND_RPMS[@]} in
    0) RPM="" ;;
    1) RPM="${FOUND_RPMS[0]}" ;;
    *)
      if (( INTERACTIVE )); then
        echo "Hay varios instaladores:"
        for i in "${!FOUND_RPMS[@]}"; do
          printf '  %d) %s\n' "$((i + 1))" "$(basename "${FOUND_RPMS[$i]}")"
        done
        ask choice "Numero del instalador a usar" "1"
        [[ "$choice" =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#FOUND_RPMS[@]} )) \
          || die "opcion no valida: '$choice'."
        RPM="${FOUND_RPMS[$((choice - 1))]}"
      else
        printf 'Instaladores encontrados:\n' >&2
        printf '  %s\n' "${FOUND_RPMS[@]}" >&2
        die "hay varios .rpm; indica cual con --rpm."
      fi
      ;;
  esac
}

RPM_LABEL=""
if [[ -n "$RPM" ]]; then
  [[ -f "$RPM" ]] || die "no existe el instalador: $RPM"
else
  choose_rpm
fi
if [[ -n "$RPM" ]]; then
  command -v rpm >/dev/null 2>&1 || die "este script necesita rpm (Fedora/RHEL/Rocky)."
  RPM_LABEL="$(rpm -qp --qf '%{NAME}-%{VERSION}-%{RELEASE}' "$RPM" 2>/dev/null)" \
    || die "no es un paquete rpm valido: $RPM"
fi

# --------------------------------------------------------------- preguntas

compute_server_defaults

if (( INTERACTIVE )); then
  if (( ! LABEL_GIVEN )); then
    echo "Etiqueta: nombre del sensor al que pertenece este equipo."
    echo "Pulsa Enter para dejarla vacia (el equipo ira al sensor por defecto)."
    cur_label="$(current_label)"
    [[ -z "$cur_label" ]] || echo "Etiqueta actual en este equipo: $cur_label"
    ask LABEL "Etiqueta" ""
  fi

  if (( ! SKIP_HOSTS )) && [[ -z "$SERVER_IP" || -z "$SERVER_NAMES_RAW" ]]; then
    echo "Servidor GRR: se anadira a $HOSTS_FILE para que este equipo lo resuelva."
    echo "Pulsa Enter para aceptar el valor entre corchetes, o escribe otro para sustituirlo."
    [[ -z "$SERVER_IP" ]]        && ask SERVER_IP "IP del servidor GRR" "$DEF_IP"
    [[ -z "$SERVER_NAMES_RAW" ]] && ask SERVER_NAMES_RAW "Nombre con dominio del servidor GRR" "$DEF_NAMES"
  fi
fi

# Sin terminal no se pregunta: se usan los valores de la plantilla (o lo ya
# configurado) y, si no se indica etiqueta, la que ya tenga el equipo.
if (( ! INTERACTIVE )); then
  (( LABEL_GIVEN )) || LABEL="$(current_label)"
  if (( ! SKIP_HOSTS )); then
    [[ -z "$SERVER_IP" ]]        && SERVER_IP="$DEF_IP"
    [[ -z "$SERVER_NAMES_RAW" ]] && SERVER_NAMES_RAW="$DEF_NAMES"
  fi
fi

LABEL="$(trim "$LABEL")"
SERVER_IP="$(trim "$SERVER_IP")"
SERVER_NAMES_RAW="$(trim "$SERVER_NAMES_RAW")"

validate_label
(( SKIP_HOSTS )) || validate_server

# --------------------------------------------------------------- resumen

echo
echo "Se va a aplicar:"
echo "  Etiqueta ........ ${LABEL:-(ninguna)}"
if (( SKIP_HOSTS )); then
  echo "  /etc/hosts ...... sin cambios (--no-hosts)"
else
  echo "  Servidor GRR .... $SERVER_IP  ${SERVER_NAMES[*]}"
fi
if [[ -n "$RPM" ]]; then
  echo "  Instalador ...... $(basename "$RPM")  ($RPM_LABEL)"
else
  echo "  Instalador ...... ninguno (se mantiene el cliente instalado)"
fi
echo

if (( INTERACTIVE && ! ASSUME_YES )); then
  ans=""
  read -r -p "Continuar? [S/n]: " ans || true
  case "${ans,,}" in
    ""|s|si|y|yes) ;;
    *) echo "Cancelado."; exit 0 ;;
  esac
fi

CHANGED=$FORCE

# ---------------------------------------------------------------- /etc/hosts

restore_context() {
  command -v restorecon >/dev/null 2>&1 && restorecon "$1" 2>/dev/null || true
}

warn_hosts_conflicts() {
  local name line
  for name in "${SERVER_NAMES[@]}"; do
    line="$(awk -v n="$name" -v ip="$SERVER_IP" -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '
      $0 == b { blk = 1; next }
      $0 == e { blk = 0; next }
      blk || /^[[:space:]]*#/ { next }
      { for (i = 2; i <= NF; i++) if (tolower($i) == tolower(n) && $1 != ip) { print; exit } }
    ' "$HOSTS_FILE")"
    if [[ -n "$line" ]]; then
      warn "'$name' ya aparece en $HOSTS_FILE con otra IP: $line"
      warn "la primera entrada del fichero es la que se usa; revisala o eliminala a mano."
    fi
  done
}

apply_hosts() {
  local tmp
  tmp="$(mktemp)"
  TMP_FILES+=("$tmp")

  [[ -f "$HOSTS_FILE" ]] || : > "$HOSTS_FILE"

  # Todo el fichero salvo nuestro bloque anterior.
  awk -v b="$HOSTS_BEGIN" -v e="$HOSTS_END" '
    $0 == b { skip = 1; next }
    $0 == e { skip = 0; next }
    !skip
  ' "$HOSTS_FILE" > "$tmp"

  # El ultimo caracter debe ser un salto de linea antes de anadir el bloque.
  if [[ -s "$tmp" && -n "$(tail -c1 "$tmp")" ]]; then
    echo >> "$tmp"
  fi
  {
    echo "$HOSTS_BEGIN"
    echo "$SERVER_IP ${SERVER_NAMES[*]}"
    echo "$HOSTS_END"
  } >> "$tmp"

  if cmp -s "$tmp" "$HOSTS_FILE"; then
    echo "$HOSTS_FILE ya estaba actualizado: $SERVER_IP ${SERVER_NAMES[*]}"
    return 0
  fi

  # Copia de seguridad la primera vez que se modifica.
  [[ -e "$HOSTS_FILE.grr.bak" ]] || cp -p "$HOSTS_FILE" "$HOSTS_FILE.grr.bak"

  # cat > conserva el inodo (valido si /etc/hosts es un enlace o un montaje).
  cat "$tmp" > "$HOSTS_FILE"
  restore_context "$HOSTS_FILE"
  CHANGED=1
  echo "$HOSTS_FILE actualizado: $SERVER_IP ${SERVER_NAMES[*]}"
}

verify_resolution() {
  local name got
  [[ "$HOSTS_FILE" == /etc/hosts ]] || return 0
  for name in "${SERVER_NAMES[@]}"; do
    got="$(getent hosts "$name" 2>/dev/null | awk '{print $1; exit}')"
    if [[ -z "$got" ]]; then
      warn "'$name' no se resuelve en este equipo."
    elif [[ "$got" != "$SERVER_IP" ]]; then
      warn "'$name' se resuelve a $got y no a $SERVER_IP (hay otra entrada que tiene prioridad)."
    fi
  done
}

check_server_port() {
  local shown="$SERVER_IP"
  [[ "$SERVER_IP" == *:* ]] && shown="[$SERVER_IP]"
  if timeout 3 bash -c ">/dev/tcp/${SERVER_IP}/${SERVER_PORT}" 2>/dev/null; then
    echo "Servidor GRR accesible en ${shown}:${SERVER_PORT}."
  else
    warn "no se pudo conectar con ${shown}:${SERVER_PORT}. Revisa red y firewall; el cliente reintentara."
  fi
}

if (( ! SKIP_HOSTS )); then
  [[ -f "$HOSTS_FILE" ]] && warn_hosts_conflicts
  apply_hosts
  verify_resolution
fi

# ------------------------------------------------------------------ etiqueta
# Primero la etiqueta, para que el cliente arranque ya con ella. Se escribe en
# un fichero temporal y se mueve, para no dejarlo a medias. Sin etiqueta, el
# fichero se elimina (el servidor lo trata como opcional).
if [[ -z "$LABEL" ]]; then
  if [[ -e "$LABEL_FILE" ]]; then
    rm -f "$LABEL_FILE"
    CHANGED=1
    echo "Etiqueta eliminada: se ha borrado $LABEL_FILE"
  else
    echo "Sin etiqueta: no hay nada que escribir en $LABEL_FILE"
  fi
else
  tmp="$(mktemp "${LABEL_FILE}.XXXXXX")"
  TMP_FILES+=("$tmp")
  printf '%s\n' "$LABEL" > "$tmp"
  chmod 0644 "$tmp"

  if [[ -f "$LABEL_FILE" ]] && cmp -s "$tmp" "$LABEL_FILE"; then
    echo "Etiqueta '$LABEL' ya estaba en $LABEL_FILE"
  else
    mv -f "$tmp" "$LABEL_FILE"
    CHANGED=1
    echo "Etiqueta '$LABEL' escrita en $LABEL_FILE"
  fi
  restore_context "$LABEL_FILE"
fi

# --------------------------------------------------------------- instalacion
# --replacepkgs permite reinstalar la misma version.
if [[ -n "$RPM" ]]; then
  rpm -U --replacepkgs "$RPM"
  CHANGED=1
fi

# ------------------------------------------------------------------ servicio
if ! systemctl cat "$SERVICE" >/dev/null 2>&1; then
  die "el servicio $SERVICE no existe. Instala primero el cliente: copia el .rpm junto a este script o usa --rpm."
fi
systemctl enable "$SERVICE" >/dev/null 2>&1 || true

# Reinicia solo si algo ha cambiado (la etiqueta se lee al arrancar el cliente).
if (( CHANGED )); then
  systemctl restart "$SERVICE"
elif ! systemctl is-active --quiet "$SERVICE"; then
  systemctl start "$SERVICE"
fi

# Espera a que quede activo.
for (( i = 0; i < WAIT_SECONDS; i++ )); do
  if systemctl is-active --quiet "$SERVICE"; then
    if [[ -n "$LABEL" ]]; then
      echo "Cliente activo con la etiqueta '$LABEL'."
    else
      echo "Cliente activo, sin etiqueta."
    fi
    (( SKIP_HOSTS )) || check_server_port
    exit 0
  fi
  sleep 1
done

echo "Error: el servicio $SERVICE no esta activo. Revisa: journalctl -u $SERVICE" >&2
exit 1
