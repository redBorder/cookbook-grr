# Generated by Chef for <%= node[:hostname] %>

configuration_name: "<%= @configuration_name %>"

components_config {
  mysql_data_source_name: "<%= @mysql_dsn %>"

  https_config {
    listen_address: "<%= @https_listen %>"
  }

  admin_config {
    listen_address: "<%= @admin_listen %>"
  }
}

trusted_cert_file: "<%= @cert_dir %>/ca.pem"
trusted_cert_key_file: "<%= @cert_dir %>/ca-key.pem"

server_cert_file: "<%= @cert_dir %>/server.pem"
server_cert_key_file: "<%= @cert_dir %>/server-key.pem"

public_host_port: "<%= @public_host_port %>"

server_component_configuration_file: "<%= @cert_dir %>/server.components.config"
linux_client_configuration_file: "<%= @cert_dir %>/linux_client.config"
darwin_client_configuration_file: "<%= @cert_dir %>/darwin_client.config"
windows_client_configuration_file: "<%= @cert_dir %>/windows_client.config"