# Generated by Chef for <%= node[:hostname] %>

Mysql.host: <%= @mysql_host %>
Mysql.port: <%= @mysql_port %>
Mysql.database: <%= @mysql_db %>
Mysql.username: <%= @mysql_user %>
Mysql.password: <%= @mysql_password %>

Database.implementation: MysqlDB

AdminUI.url: "<%= @adminui_url %>"
AdminUI.port: <%= @adminui_port %>
AdminUI.webauth_manager: BasicWebAuthManager
AdminUI.csrf_secret_key: "<%= @csrf_secret_key %>"

Frontend.bind_port: <%= @frontend_port %>
Client.server_urls:
  - "<%= @frontend_url %>/"

Client.fleetspeak_enabled: true
Server.fleetspeak_message_listen_address: "<%= @fleetspeak_grr_listen %>"
Server.fleetspeak_server: "<%= @fleetspeak_admin_listen %>"
Server.initialized: True
