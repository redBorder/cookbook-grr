# Generated by Chef for <%= node[:hostname] %>

Mysql.host: <%= @mysql_host %>
Mysql.port: <%= @mysql_port %>
Mysql.database: <%= @mysql_db %>
Mysql.username: <%= @mysql_user %>
Mysql.password: <%= @mysql_password %>

Database.implementation: MysqlDB

AdminUI.url: "<%= @adminui_url %>"
AdminUI.port: <%= @adminui_port %>
AdminUI.webauth_manager: BasicWebAuthManager
AdminUI.csrf_secret_key: "<%= @csrf_secret_key %>"

Frontend.bind_port: <%= @frontend_port %>
Client.server_urls:
  - "<%= @frontend_url %>/"

Client.fleetspeak_enabled: true
Server.fleetspeak_message_listen_address: "<%= @fleetspeak_grr_listen %>"
Server.fleetspeak_server: "<%= @fleetspeak_admin_listen %>"
Server.initialized: True

ClientBuilder.fleetspeak_bundled: True

Target:Linux:
  ClientBuilder.fleetspeak_client_config: <%= @fleetspeak_client_config %>
  Client.labels: "%(/etc/grr_labels|optionalfile)"

Target:Windows:
  ClientBuilder.fleetspeak_client_config: <%= @fleetspeak_client_config_windows %>
  Client.labels: "%(C:/ProgramData/GRR/grr_labels|optionalfile)"

CA.certificate: |
<%= @ca_certificate.each_line.map { |l| "  #{l.strip}" }.join("\n") %>

PrivateKeys.ca_key: |
<%= @ca_key.each_line.map { |l| "  #{l.strip}" }.join("\n") %>

Frontend.certificate: |
<%= @server_certificate.each_line.map { |l| "  #{l.strip}" }.join("\n") %>

PrivateKeys.server_key: |
<%= @server_key.each_line.map { |l| "  #{l.strip}" }.join("\n") %>

Client.executable_signing_public_key: |
<%= @executable_signing_public_key.each_line.map { |l| "  #{l.strip}" }.join("\n") %>

PrivateKeys.executable_signing_private_key: |
<%= @executable_signing_private_key.each_line.map { |l| "  #{l.strip}" }.join("\n") %>